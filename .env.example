# Copy to .env.local. Nothing here is a real secret; make your own values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/signin
# 32 or more random characters. `openssl rand -base64 48` makes one.
SESSION_SECRET=
# Seconds without a touch before the kiosk goes back to "Scan your code".
KIOSK_IDLE_SECONDS=15
