# Copy to .env.local. Nothing here is a real secret; make your own values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/signin
# 32 or more random characters. `openssl rand -base64 48` makes one.
SESSION_SECRET=
# Seconds without a touch before the kiosk goes back to "Scan your code".
KIOSK_IDLE_SECONDS=15
# Minutes with no scan and no touch before the kiosk dims. 0 means it never dims.
KIOSK_DIM_MINUTES=60
# "1" on a copy that holds made-up names only. The dashboard and the kiosk then
# show a "Test copy" tag, and the seed script will fill a hosted database.
# Leave it empty on the real one.
TEST_COPY=
# "Add to Wallet" on a member's page. Leave the key empty and the buttons are not shown.
# No key exists yet; do not put a real one in this file.
WALLETWALLET_API_KEY=
# Test servers on this machine only: "1" makes passes come from a built-in stand-in.
# It is ignored on the real host (anywhere VERCEL or VERCEL_ENV is set).
WALLET_STAND_IN=
# Checking a task off from Slack. Leave it empty and the Slack address refuses every request.
# It is the "Signing Secret" of the team's own Slack app, which an admin installs.
SLACK_SIGNING_SECRET=
# "Draft steps" on the task form. Leave the key empty and the button is not shown.
# Who pays for the key is an open decision; do not put a real key in this file.
ANTHROPIC_API_KEY=
# Test servers on this machine only: "1" makes drafting use built-in made-up steps
# and no key. It is ignored on the real host (anywhere VERCEL or VERCEL_ENV is set).
# It is ignored when VERCEL_ENV is "production".
STEP_DRAFTS_STAND_IN=
